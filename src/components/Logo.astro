---
// Kaiyori mark: a K whose upper arm climbs in small steps (kaizen: keep getting better, one step at a time).
// Dark K on an orange rounded square; colours come from styles.css (.logo-*), so it follows the theme.
const { size = 28 } = Astro.props;
---
<svg class="logo" viewBox="0 0 32 32" width={size} height={size} aria-hidden="true" focusable="false">
  <rect class="logo-bg" width="32" height="32" rx="8" />
  <path class="logo-k" d="M7 6h5v20H7zM12 13h4V9.5h4V6h5v5h-4v3.5h-4V18h-5zM12 16h5.5l8 10H20z" />
</svg>
