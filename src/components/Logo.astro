---
// Kaiyori mark: whale silhouette in an orange rounded square. Colours come from styles.css (.logo-*), so it follows the theme.
const { size = 28 } = Astro.props;
---
<svg class="logo" viewBox="0 0 32 32" width={size} height={size} aria-hidden="true" focusable="false">
  <rect class="logo-bg" width="32" height="32" rx="8" />
  <path class="logo-whale" d="M5 18.2C5 13.6 9 11 14 11c4.2 0 7 2.2 8.6 4.6.9 1.3 1.9 1.6 2.9.6l1.2-3.3c1.1-.4 1.8.4 1.5 1.6-.7 3.1-2.2 6-5 7.6-3.2 1.8-7.6 1.9-11.6 1.5C8.8 22.3 5 21.8 5 18.2Z" />
  <path class="logo-spout" d="M9.5 8.8c-.1-1.2-1-1.9-1.8-2.6M9.5 8.8c.1-1.2 1-1.9 1.8-2.6" />
  <circle class="logo-eye" cx="8.4" cy="16.3" r=".9" />
</svg>
