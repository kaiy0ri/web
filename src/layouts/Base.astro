---
import "../styles.css";
import { site } from "../site";
import { getChanges } from "../changelog";
import Logo from "../components/Logo.astro";
import { whaleArt } from "../skysea";

const latest = (await getChanges())[0];
const earlyAccess = `mailto:${site.email}?subject=Kaiyori%20early%20access`;
const whale = whaleArt(56, 1); // the sky whale from src/skysea.ts, drawn as text at build time, a little taller

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
  ld?: object;
}
const { title = site.brand.name, description = site.brand.description, type = "website", ld } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;
// Structured data for search engines and AI answer engines: who runs the site, plus any page-specific item.
const org = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.brand.name,
  url: "https://kamllistos.com/",
  logo: "https://kamllistos.com/icon.png",
  description: site.brand.description,
  founder: { "@type": "Person", name: site.name, url: "https://camtoan.me" },
  sameAs: site.links.map((l) => l.url),
};
const graph = JSON.stringify(ld ? [org, ld] : org).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg?v=k2" type="image/svg+xml" />
    <link rel="icon" href="/icon-48.png?v=k2" type="image/png" sizes="48x48" />
    <link rel="icon" href="/icon.png?v=k2" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=k2" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.brand.name} />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://kamllistos.com/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={url} />
    <link rel="sitemap" href="/sitemap.xml" />
    <script type="application/ld+json" set:html={graph} />
    <title>{title}</title>
    <meta name="color-scheme" content="light dark" />
    <script is:inline src="/theme.js"></script>
  </head>
  <body>
    <nav class="nav glass" aria-label="Main">
      <div class="nav-inner">
        <a class="nav-brand" href="/" aria-label={`${site.brand.name} home`}><Logo size={28} /><span>{site.brand.name}</span></a>
        <div class="nav-menu">
          <details class="nav-dd">
            <summary>Product</summary>
            <div class="nav-panel">
              <a href="/#how">How it works</a>
              <a href="/products/">Toolkit</a>
            </div>
          </details>
          <details class="nav-dd">
            <summary>Resources</summary>
            <div class="nav-panel">
              <a href="/docs/">Docs</a>
              <a href="/changelog/">Changelog</a>
              <a href="/stack/">Stack</a>
              <a href="https://camtoan.me/blog">Blog</a>
            </div>
          </details>
          <a class="nav-plain" href={`mailto:${site.email}`}>Contact</a>
        </div>
        <div class="nav-end">
          <div class="theme" role="group" aria-label="Colour theme">
            <button type="button" data-theme-set="system" aria-pressed="true">Auto</button>
            <button type="button" data-theme-set="light" aria-pressed="false">Light</button>
            <button type="button" data-theme-set="dark" aria-pressed="false">Dark</button>
          </div>
          <a class="nav-cta" href={earlyAccess}>Get early access <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </nav>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="f-top">
        <a class="f-brand" href="/" aria-label={`${site.brand.name} home`}><Logo size={30} /><span>{site.brand.name}</span></a>
        <div class="f-social">
          {site.links.map((l) => (
            <a href={l.url} rel="noopener noreferrer" aria-label={l.label} title={l.label}>
              {l.label === "GitHub" ? (
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 .5A11.5 11.5 0 0 0 .5 12c0 5.08 3.29 9.38 7.86 10.9.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.34.96.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"/></svg>
              ) : l.label === "Substack" ? (
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M22.54 8.3H1.46V5.6h21.08v2.7ZM1.46 10.8V24L12 18.1 22.54 24V10.8H1.46ZM22.54 0H1.46v2.7h21.08V0Z"/></svg>
              ) : (<span>{l.label}</span>)}
            </a>
          ))}
        </div>
      </div>
      <div class="f-cols">
        <div>
          <h2>Product</h2>
          <a href="/#how">How it works</a>
          <a href="/products/">Toolkit</a>
          <a href={earlyAccess}>Early access</a>
        </div>
        <div>
          <h2>Resources</h2>
          <a href="/docs/">Docs</a>
          <a href="/changelog/">Changelog</a>
          <a href="/stack/">Stack</a>
          <a href="https://camtoan.me/blog">Blog</a>
        </div>
        <div>
          <h2>Company</h2>
          <a href="https://camtoan.me">About</a>
          <a href={`mailto:${site.email}`}>Contact</a>
          <a href="/security/">Security &amp; disclosure</a>
        </div>
        <div>
          <h2>Legal</h2>
          <a href="/legal/">Legal &amp; privacy</a>
          <a href="/legal/privacy-policy/">Privacy policy</a>
          <a href="/legal/terms/">Terms</a>
        </div>
      </div>
      <div class="f-bottom">
        <pre class="f-whale" aria-hidden="true" set:html={whale} />
        <span>© {new Date().getFullYear()} {site.brand.name} · built by {site.name}</span>
        {latest && <a class="updated" href="/changelog/" data-updated={latest.date}>Last update: {new Date(latest.date).toLocaleDateString("en-US", { dateStyle: "medium", timeZone: "America/Edmonton" })}</a>}
      </div>
    </footer>
    <script is:inline src="/site.js" defer></script>
    <script is:inline src="/glass.js" defer></script>
  </body>
</html>
